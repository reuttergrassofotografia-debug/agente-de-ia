{
  "name": "@agente/api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx/esm --watch src/index.ts",
    "backfill:photos": "node --env-file=../../.env --import tsx/esm src/scripts/backfill-profile-pictures.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agente/db": "*",
    "@agente/queue": "*",
    "@agente/evolution": "*",
    "fastify": "^4.27.0",
    "@fastify/cors": "^9.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.11.0",
    "vitest": "^1.6.0"
  }
}
